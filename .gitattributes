# Normalize line endings: LF in the repository, LF in the working tree.
# Required because core.autocrlf=true would otherwise check out shell scripts
# with CRLF and break them on Unix (bad interpreter: /bin/bash^M).
* text=auto eol=lf

# Scripts that must run on Unix
*.sh   text eol=lf
*.py   text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets (never diff, never convert)
*.zip  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
